<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="4dp" android:insetRight="4dp" android:insetTop="4dp" android:insetBottom="4dp">
    <ripple android:color="@color/button_ripple">
        <item>
            <shape android:shape="rectangle">
                <corners android:radius="14dp" />
                <solid android:color="@color/button_surface_states" />
                <stroke android:width="1dp" android:color="@color/button_outline" />
            </shape>
        </item>
    </ripple>
</inset>
