<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?android:attr/colorBackground">
    <View android:id="@+id/statusBarView" android:layout_width="match_parent"
        android:layout_height="0dp" android:background="@color/colorPrimaryDark" />
    <com.chao.peakmusic.widget.CustomToolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        android:background="@color/colorPrimary" app:text_title="@string/music_playing" />
    <!-- Metadata and lyrics can scroll on small screens; transport controls never leave the dock. -->
    <androidx.core.widget.NestedScrollView android:id="@+id/player_content"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal" android:padding="12dp">
            <com.chao.peakmusic.widget.MusicAlbumView android:id="@+id/album_music"
                android:layout_width="160dp" android:layout_height="160dp"
                android:contentDescription="@string/album_cover" android:src="@drawable/default_cover"
                android:transitionName="album" />
            <TextView android:id="@+id/tv_music_name" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:gravity="center" android:textSize="21sp" android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary" />
            <TextView android:id="@+id/tv_music_singer" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center" android:textSize="15sp"
                android:textColor="?android:attr/textColorSecondary" />
            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button android:id="@+id/playback_favorite" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:minWidth="0dp" android:minHeight="48dp"
                    android:text="@string/add_favorite" app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/playback_mode" app:layout_constraintTop_toTopOf="parent" />
                <Button android:id="@+id/playback_mode" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:minWidth="0dp" android:minHeight="48dp"
                    android:text="@string/play_mode" app:layout_constraintStart_toEndOf="@id/playback_favorite"
                    app:layout_constraintEnd_toStartOf="@id/lyrics_calibrate" app:layout_constraintTop_toTopOf="parent" />
                <Button android:id="@+id/lyrics_calibrate" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:minWidth="0dp" android:minHeight="48dp"
                    android:text="@string/lyrics_calibrate" app:layout_constraintStart_toEndOf="@id/playback_mode"
                    app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView android:id="@+id/lyric_offset_value" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center"
                android:textColor="?android:attr/textColorSecondary" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/lyrics_list"
                android:layout_width="match_parent" android:layout_height="240dp" android:clipToPadding="false" />
            <Button android:id="@+id/lyrics_retry" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/retry"
                android:visibility="gone" />
            <Button android:id="@+id/lyrics_follow" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/follow_current_lyric" android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView android:id="@+id/playback_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingHorizontal="12dp" android:maxLines="2"
        android:gravity="center" android:textColor="?android:attr/textColorSecondary"
        android:accessibilityLiveRegion="polite" android:visibility="gone" />
    <SeekBar android:id="@+id/playback_progress" android:layout_width="match_parent"
        android:layout_height="48dp" android:layout_marginHorizontal="12dp"
        android:contentDescription="@string/playback_progress" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp">
        <TextView android:id="@+id/playback_current_time" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="start" android:text="@string/time_zero"
            android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
        <TextView android:id="@+id/playback_total_time" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="end" android:text="@string/time_zero"
            android:textSize="12sp" android:textColor="?android:attr/textColorSecondary" />
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/playback_controls"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="12dp">
        <Button android:id="@+id/playback_previous" android:layout_width="0dp"
            android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="0dp"
            android:text="@string/player_previous" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/playback_toggle" app:layout_constraintTop_toTopOf="parent" />
        <Button android:id="@+id/playback_toggle" style="@style/Widget.AppButton.Primary" android:layout_width="0dp"
            android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="0dp"
            android:text="@string/player_play" app:layout_constraintStart_toEndOf="@id/playback_previous"
            app:layout_constraintEnd_toStartOf="@id/playback_next" app:layout_constraintTop_toTopOf="parent" />
        <Button android:id="@+id/playback_next" android:layout_width="0dp"
            android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="0dp"
            android:text="@string/player_next" app:layout_constraintStart_toEndOf="@id/playback_toggle"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
